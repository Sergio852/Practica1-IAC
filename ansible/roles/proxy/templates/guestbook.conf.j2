# Proxy inverso hacia el servidor web. Generado por Ansible.
upstream web_apache {
    server {{ web_front_ip }}:80;
}

server {
    listen 80;
    server_name {{ proxy_nombre }};

    location / {
        proxy_pass http://web_apache;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
