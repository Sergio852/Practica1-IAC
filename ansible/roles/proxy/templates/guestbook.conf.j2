# Proxy inverso del escenario. Generado por Ansible.

# Caché de ficheros estáticos
proxy_cache_path {{ cache_dir }} levels=1:2 keys_zone=estaticos:10m max_size={{ cache_max }} inactive=60m use_temp_path=off;

# Límite de peticiones: se cuenta por IP del cliente
limit_req_zone $binary_remote_addr zone=nuevo:10m rate={{ limite_tasa }};

# Sesiones persistentes: cada usuario lleva una cookie con un identificador.
# Si todavía no la tiene (primera visita), se usa un identificador nuevo.
map $cookie_{{ cookie_usuario }} $clave_usuario {
    ""      $request_id;
    default $cookie_{{ cookie_usuario }};
}

# Balanceo de carga: cada usuario va siempre a la misma web según su cookie.
# Si una web falla max_fails veces, se deja fuera durante fail_timeout.
upstream web_apache {
    hash $clave_usuario consistent;
{% for ip in web_front_ips %}
    server {{ ip }}:80 max_fails={{ balanceo_max_fallos }} fail_timeout={{ balanceo_tiempo_fuera }};
{% endfor %}
}

upstream estado_gatus {
    server {{ docker_front_ip }}:{{ docker_puerto }};
}

# HTTP: solo redirige a HTTPS, para los dos nombres
server {
    listen 80;
    server_name {{ proxy_nombre }} {{ estado_nombre }};
    return 301 https://$host$request_uri;
}

# HTTPS: la guestbook, repartida entre las webs
server {
    listen 443 ssl;
    server_name {{ proxy_nombre }};

    ssl_certificate     /etc/ssl/certs/proxy.crt;
    ssl_certificate_key /etc/ssl/private/proxy.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age={{ hsts_max_age }}" always;

    # Le doy (o le renuevo) al usuario su cookie, para que vuelva siempre a la misma web
    add_header Set-Cookie "{{ cookie_usuario }}=$clave_usuario; Path=/; Secure; HttpOnly; SameSite=Lax" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Si una web no responde o da error, la petición se repite en otra web
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_connect_timeout {{ balanceo_tiempo_conexion }};


    # Si no responde ninguna web, enseño mi página de mantenimiento con un 503
    error_page 502 503 504 =503 /mantenimiento.html;

    location = /mantenimiento.html {
        root {{ mantenimiento_dir }};
        internal;
    }

    # Ficheros estáticos: se sirven desde la caché del proxy
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        proxy_pass http://web_apache;
        proxy_cache estaticos;
        proxy_cache_valid 200 {{ cache_validez }};
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Strict-Transport-Security "max-age={{ hsts_max_age }}" always;
    }

    # Formulario: limita las peticiones y responde 429 si se superan
    location /nuevo {
        limit_req zone=nuevo burst={{ limite_rafaga }} nodelay;
        limit_req_status 429;
        proxy_pass http://web_apache;
    }

    # Todo lo demás (las páginas de la aplicación) no se cachea ni se limita
    location / {
        proxy_pass http://web_apache;
    }
}

# HTTPS: el panel de estado (Gatus, en contenedores en la máquina docker)
server {
    listen 443 ssl;
    server_name {{ estado_nombre }};

    ssl_certificate     /etc/ssl/certs/proxy.crt;
    ssl_certificate_key /etc/ssl/private/proxy.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age={{ hsts_max_age }}" always;

    location / {
        proxy_pass http://estado_gatus;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
