# Proxy inverso hacia el servidor web. Generado por Ansible.

# Caché de ficheros estáticos
proxy_cache_path {{ cache_dir }} levels=1:2 keys_zone=estaticos:10m max_size={{ cache_max }} inactive=60m use_temp_path=off;

# Límite de peticiones: se cuenta por IP del cliente
limit_req_zone $binary_remote_addr zone=nuevo:10m rate={{ limite_tasa }};

upstream web_apache {
    server {{ web_front_ip }}:80;
}

# HTTP: solo redirige a HTTPS
server {
    listen 80;
    server_name {{ proxy_nombre }};
    return 301 https://{{ proxy_nombre }}$request_uri;
}

# HTTPS: sirve la aplicación a través de web
server {
    listen 443 ssl;
    server_name {{ proxy_nombre }};

    ssl_certificate     /etc/ssl/certs/proxy.crt;
    ssl_certificate_key /etc/ssl/private/proxy.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age={{ hsts_max_age }}" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Ficheros estáticos: se sirven desde la caché del proxy
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        proxy_pass http://web_apache;
        proxy_cache estaticos;
        proxy_cache_valid 200 {{ cache_validez }};
        add_header X-Cache-Status $upstream_cache_status always;
        add_header Strict-Transport-Security "max-age={{ hsts_max_age }}" always;
    }

    # Formulario: limita las peticiones y responde 429 si se superan
    location /nuevo {
        limit_req zone=nuevo burst={{ limite_rafaga }} nodelay;
        limit_req_status 429;
        proxy_pass http://web_apache;
    }

    # Todo lo demás (las páginas de la aplicación) no se cachea ni se limita
    location / {
        proxy_pass http://web_apache;
    }
}
